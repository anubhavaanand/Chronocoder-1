# Docker ignore for ChronoCoder v3
# Exclude old v2 Streamlit files and build artifacts

# Old v2 Streamlit app directory
chronocoder/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
venv/
env/
.env

# Build outputs
.next/
out/
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Testing
.coverage
.pytest_cache/
.tox/

# Docker
docker-compose.override.yml

# Render/Deploy specific
*.styles.py
styles.py

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.tmp
*.temp
.cache/