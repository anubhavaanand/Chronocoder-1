# ChronoCoder — Environment Variables
# Copy to .env.local (frontend) and/or export in your shell (backend).
# Values marked REQUIRED must be set for the app to function.

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini (REQUIRED for AI feedback)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (REQUIRED for auth + persistence)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — must be NEXT_PUBLIC_* to reach the browser
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public base URL of this deployment, used for metadataBase, sitemap, and
# robots.txt. Defaults to https://chronocoder-1.onrender.com when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Backend server
# ─────────────────────────────────────────────────────────────────────────────
# Runtime mode. "production" disables uvicorn reload and makes auth/database
# misconfiguration a hard 500 instead of a silent dev fallback.
FASTAPI_ENV=development
# Force uvicorn reload on/off. Overrides FASTAPI_ENV when set (true/false/1/0).
# FASTAPI_RELOAD=true
# UVICORN_RELOAD=false
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# Backend — CORS & proxy trust (security)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated allowed browser origins. Defaults to localhost:3000,
# 127.0.0.1:3000, https://chronocoder.com, https://www.chronocoder.com.
ALLOWED_ORIGINS=http://localhost:3000
# Legacy alias for ALLOWED_ORIGINS (used only if ALLOWED_ORIGINS is unset).
# CORS_ORIGINS=http://localhost:3000
# Comma-separated proxy IPs whose X-Forwarded-For / CF-Connecting-IP headers are
# trusted for client-IP resolution. Leave empty when not behind a proxy.
TRUSTED_PROXIES=

# ─────────────────────────────────────────────────────────────────────────────
# Backend — limits & tuning
# ─────────────────────────────────────────────────────────────────────────────
# Max sliding-window rate-limit keys kept in memory (LRU-evicted).
MAX_RATE_LIMIT_KEYS=10000
# Max concurrent WebSocket connections (new connections get close code 1013).
MAX_WS_CONNECTIONS=1000
# Artificial delay between streamed chunks, ms. 0 = stream as fast as possible.
WS_STREAM_PACE_MS=0
# Override the Gemini output-token cap (MAX_OUTPUT_TOKENS wins; this is the alias).
GEMINI_MAX_OUTPUT_TOKENS=8192
# MAX_OUTPUT_TOKENS=8192
# Directory containing mentor JSON personas. Defaults to backend/mentors.
# MENTORS_DIR=backend/mentors