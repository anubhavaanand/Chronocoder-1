{
  "name": "chronocoder-v3-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for ChronoCoder v3",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --dir tests/integration",
    "test:unit": "vitest run --dir tests/components",
    "test:hooks": "vitest run --dir tests/hooks",
    "test:performance": "node performance-test-runner.js",
    "test:ci": "vitest run --coverage --reporter=junit --reporter=json",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "test:update-snapshots": "vitest run -u",
    "test:types": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "happy-dom": "^17.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.6.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "monaco-editor": "^0.52.0",
    "@monaco-editor/react": "^4.7.0",
    "framer-motion": "^11.11.0",
    "remark-gfm": "^4.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "react-syntax-highlighter": "^15.6.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
